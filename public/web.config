<?xml version="1.0" encoding="utf-8"?>
<!--
    API_AT Configuration Setting Explanation:
    
    This is an ASP.NET application setting defined in the web.config file, which is the primary 
    configuration file for ASP.NET web applications hosted on IIS (Internet Information Services).
    
    What it does:
    The line <add key="API_AT" value="n20api" /> creates a configuration key-value pair named 
    API_AT with the value "n20api". In ASP.NET applications, these appSettings entries act as 
    application-wide constants that can be accessed from anywhere in your code. This particular 
    setting appears to define an API authentication token or API access type identifier used 
    throughout your application.
    
    How it's accessed:
    In your C# server-side code, this value would typically be retrieved using 
    ConfigurationManager.AppSettings["API_AT"], which would return the string "n20api". This 
    allows you to centralize configuration values in one place rather than hardcoding them 
    throughout your codebase.
    
    This setting sits alongside AUTH_TYPE (set to "fb", google firebase authentication) and 
    NODE_ENV (set to "production"). This suggests your application is a hybrid setup - possibly 
    a React/Vite frontend bundled with an ASP.NET backend, where the web.config manages both 
    IIS hosting rules and application-level settings.
-->
<configuration>
<appSettings>
    <add key="AUTH_TYPE" value="basic" />
    <add key="TENANT_NICKNAME" value="netzoom-uhjpe" />
    <add key="TENANT_DISPLAY_NAME" value="NetZoom" />
    <add key="API_AT" value="n20api" />
    <add key="NODE_ENV" value="production" />
    <add key="BASIC_AUTH_ENDPOINT" value="/api/login.aspx" />
    <add key="NETZOOM_AUTH_ENDPOINT" value="/api/login.aspx" />
    <add key="DEPLOYMENT" value="OnPremises" />
    <add key="DATE_INSTALLED" value="2026-06-01" />
    <add key="DATE_LASTUPDATED" value="2026-06-01" />
    <add key="DEPLOYMENT_N20_API_URL" value="/n20api" />
    <add key="DEPLOYMENT_N20_API_BASEURL" value="https://n20a.netzoom.com" />
    <add key="DEPLOYMENT_DCMLISTENER_API_URL" value="/dcmlistener" />
    <add key="DEPLOYMENT_EXPSERVER_API_URL" value="/expapi" />
    <add key="DEPLOYMENT_NZINTHUB_API_URL" value="/nzinthubapi" />
    <add key="FIREBASE_API_KEY" value="AIzaSyAIJWkLaM7kYogZ4FJWCNq3sWvK4N2awxY" />
    <add key="FIREBASE_AUTH_DOMAIN" value="n20-fb-01.firebaseapp.com" />
    <add key="FIREBASE_PROJECT_ID" value="n20-fb-01" />
    <add key="FIREBASE_APP_ID" value="1:608261150760:web:6d7e0eb75515a000657d1d" />
  </appSettings>
  <system.webServer>
    <rewrite>
      <rules>
                <!-- Remove any inherited rewrite rules before applying the rules below -->
                <clear />

                <!-- Proxy requests matching /dcmlistener/* to the local export API service on port 6463 -->
                <rule name="ReverseProxyInboundRule2" stopProcessing="true">
                    <match url="^dcmlistener/(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Rewrite" url="http://localhost:6463/dcmlistener/{R:1}" />
                </rule>

                <!-- Proxy requests matching /expapi/* to the local export API service on port 6464 -->
                <rule name="ReverseProxyInboundRule1" stopProcessing="true">
                    <match url="^expapi/(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Rewrite" url="http://localhost:6464/expapi/{R:1}" />
                </rule>

                <!-- Proxy requests matching /nzinthubapi/* to the local export API service on port 6465 -->
                <rule name="ReverseProxyInboundRule3" stopProcessing="true">
                    <match url="^nzinthubapi/(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Rewrite" url="http://localhost:6465/nzinthubapi/{R:1}" />
                </rule>


                <!-- Catch-all rule to support React client-side routing.
                     Rewrites any request that is not a physical file or directory to /index.html,
                     allowing the React app to handle the route on the client. -->
                <rule name="React Router" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="/index.html" />
                </rule>
      </rules>
    </rewrite>
    <staticContent>
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
